# PostgreSQL development database
POSTGRES_DB=mra
POSTGRES_USER=mra
POSTGRES_PASSWORD=mra_dev_password

# Services use the Compose hostname `postgres` from inside Docker.
DATABASE_URL=postgresql+psycopg://mra:mra_dev_password@postgres:5432/mra
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Authentication cookies. Set secure=true behind HTTPS in production.
SESSION_COOKIE_NAME=mra_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=1800
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_SECONDS=300

# Production requires SESSION_COOKIE_NAME=__Host-mra_session,
# SESSION_COOKIE_SECURE=true and HTTPS-only CORS/AUTH origins.
